package main

import (
	"context"
	"fmt"
	"log"
	"sync"
	"sync/atomic"
	"time"

	"gorm.io/driver/sqlite"
	"gorm.io/gorm"
	"gorm.io/gorm/logger"
)

// DataModel 定义数据模型接口
type DataModel interface {
	TableName() string
	FetchByPlayerID(db *gorm.DB, playerID uint) (interface{}, error)
}

// 缓存分片数量
const (
	LockShardCount   = 32          // 分片锁数量
	CacheTTL         = 5 * time.Minute
	CleanupInterval  = 2 * time.Minute
	IdleThreshold    = 10 * time.Minute
)

// 全局变量
var (
	globalDB           *gorm.DB        // 全局数据库连接
	globalDBCounter    int32           // 数据库连接计数器
	cacheManager       *CacheManager   // 缓存管理器
	tableModelFactories = make(map[string]func() DataModel) // 表名到结构体工厂函数的映射
)

// 缓存项
type CacheItem struct {
	Data       interface{}
	ExpireTime time.Time
}

// 缓存管理器
type CacheManager struct {
	playerCaches    map[uint]*Player            // 玩家对象缓存
	tableDataCaches map[uint]map[string]*CacheItem // 按玩家ID分组的表数据缓存
	lastAccessTime  map[uint]time.Time          // 玩家最后访问时间记录
	locks           [LockShardCount]sync.RWMutex // 分片锁
	globalLock      sync.RWMutex                // 保护全局数据结构的锁
}

// 创建新的缓存管理器
func NewCacheManager() *CacheManager {
	return &CacheManager{
		playerCaches:    make(map[uint]*Player),
		tableDataCaches: make(map[uint]map[string]*CacheItem),
		lastAccessTime:  make(map[uint]time.Time),
	}
}

// 获取玩家对应的锁
func (cm *CacheManager) getPlayerLock(playerID uint) *sync.RWMutex {
	shardIndex := playerID % LockShardCount
	return &cm.locks[shardIndex]
}

// 获取或创建玩家缓存
func (cm *CacheManager) getOrCreatePlayerCache(playerID uint) (*Player, error) {
	playerLock := cm.getPlayerLock(playerID)
	playerLock.RLock()

	player, exists := cm.playerCaches[playerID]
	playerLock.RUnlock()

	if exists {
		// 更新最后访问时间
		cm.globalLock.Lock()
		cm.lastAccessTime[playerID] = time.Now()
		cm.globalLock.Unlock()
		return player, nil
	}

	// 缓存未命中，从数据库加载
	var p Player
	tx := globalDB.WithContext(context.Background()).Where("id = ?", playerID).First(&p)
	if tx.Error != nil {
		return nil, fmt.Errorf("player %d not found: %w", playerID, tx.Error)
	}

	// 双重检查锁定模式
	playerLock.Lock()
	defer playerLock.Unlock()

	player, exists = cm.playerCaches[playerID]
	if !exists {
		player = &p
		cm.playerCaches[playerID] = player

		// 创建对应的表数据缓存映射
		cm.globalLock.Lock()
		cm.lastAccessTime[playerID] = time.Now()
		if _, exists := cm.tableDataCaches[playerID]; !exists {
			cm.tableDataCaches[playerID] = make(map[string]*CacheItem)
		}
		cm.globalLock.Unlock()
	}

	return player, nil
}

// 获取或创建表缓存
func (cm *CacheManager) getOrCreateTableCache(playerID uint, tableName string) *CacheItem {
	playerLock := cm.getPlayerLock(playerID)
	playerLock.RLock()

	// 检查玩家的表数据缓存是否存在
	cm.globalLock.RLock()
	tableCaches, exists := cm.tableDataCaches[playerID]
	cm.globalLock.RUnlock()

	var tableCache *CacheItem
	var tableCacheExists bool

	if exists {
		playerLock.RUnlock()
		playerLock.Lock()
		tableCache, tableCacheExists = tableCaches[tableName]
		playerLock.Unlock()
	} else {
		playerLock.RUnlock()
		playerLock.Lock()
		// 再次检查
		cm.globalLock.RLock()
		tableCaches, exists = cm.tableDataCaches[playerID]
		cm.globalLock.RUnlock()

		if !exists {
			cm.globalLock.Lock()
			tableCaches = make(map[string]*CacheItem)
			cm.tableDataCaches[playerID] = tableCaches
			cm.globalLock.Unlock()
		}
		playerLock.Unlock()
	}

	// 如果表缓存不存在，创建新的缓存项
	if !tableCacheExists {
		playerLock.Lock()
		tableCache = &CacheItem{
			ExpireTime: time.Now().Add(CacheTTL),
		}
		tableCaches[tableName] = tableCache
		playerLock.Unlock()
	}

	return tableCache
}

// 获取缓存数据，如果过期则重新加载
func (cm *CacheManager) getCacheData(tableCache *CacheItem, db *gorm.DB, playerID uint, tableName string) (interface{}, error) {
	// 检查缓存是否有效
	if tableCache.Data != nil && time.Now().Before(tableCache.ExpireTime) {
		return tableCache.Data, nil
	}

	// 缓存已过期或为空，重新加载数据
	factory, exists := tableModelFactories[tableName]
	if !exists {
		return nil, fmt.Errorf("no factory registered for table: %s", tableName)
	}

	// 使用纯接口方式加载数据
	dataModel := factory()
	data, err := dataModel.FetchByPlayerID(db, playerID)
	if err != nil {
		return nil, fmt.Errorf("failed to fetch data for table %s: %w", tableName, err)
	}

	// 更新缓存数据和过期时间
	playerLock := cm.getPlayerLock(playerID)
	playerLock.Lock()
	tableCache.Data = data
	tableCache.ExpireTime = time.Now().Add(CacheTTL)
	playerLock.Unlock()

	return data, nil
}

// 启动定时缓存清理任务
func (cm *CacheManager) StartCleaner(interval time.Duration, idleThreshold time.Duration) {
	ticker := time.NewTicker(interval)
	go func() {
		for range ticker.C {
			cm.cleanup(idleThreshold)
		}
	}()
}

// 清理长时间未访问的缓存
func (cm *CacheManager) cleanup(idleThreshold time.Duration) {
	now := time.Now()

	// 找出需要清理的玩家ID
	cm.globalLock.RLock()
	var toClean []uint
	for playerID, lastTime := range cm.lastAccessTime {
		if now.Sub(lastTime) > idleThreshold {
			toClean = append(toClean, playerID)
		}
	}
	cm.globalLock.RUnlock()

	// 逐个清理
	for _, playerID := range toClean {
		playerLock := cm.getPlayerLock(playerID)
		playerLock.Lock()

		// 再次检查是否需要清理（避免并发问题）
		cm.globalLock.RLock()
		lastTime, exists := cm.lastAccessTime[playerID]
		cm.globalLock.RUnlock()

		if exists && now.Sub(lastTime) > idleThreshold {
			// 删除玩家缓存
			delete(cm.playerCaches, playerID)

			// 删除表数据缓存和访问时间
			cm.globalLock.Lock()
			delete(cm.tableDataCaches, playerID)
			delete(cm.lastAccessTime, playerID)
			cm.globalLock.Unlock()

			log.Printf("Cache cleanup: removed data for player %d (idle > %v)", playerID, idleThreshold)
		}

		playerLock.Unlock()
	}
}

// Player 结构体定义玩家对象
type Player struct {
	ID   uint   `gorm:"primaryKey" json:"id"`
	Name string `json:"name"`
}

// 定义表名
func (Player) TableName() string {
	return "players"
}

// FetchByPlayerID 实现DataModel接口的查询方法
func (p *Player) FetchByPlayerID(db *gorm.DB, playerID uint) (interface{}, error) {
	var player Player
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second) // 添加超时控制
	defer cancel()

	if err := db.WithContext(ctx).Where("id = ?", playerID).First(&player).Error; err != nil {
		atomic.AddInt32(&globalDBCounter, 1)
		return nil, err
	}

	atomic.AddInt32(&globalDBCounter, 1)
	return player, nil
}

// 定义InventoryItem结构体
type InventoryItem struct {
	ID       uint `gorm:"primaryKey"`
	PlayerID uint
	ItemID   uint
	Quantity int
}

// 为InventoryItem定义表名方法
func (InventoryItem) TableName() string {
	return "inventory"
}

// FetchByPlayerID 实现DataModel接口的查询方法
func (i *InventoryItem) FetchByPlayerID(db *gorm.DB, playerID uint) (interface{}, error) {
	var item InventoryItem
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second) // 添加超时控制
	defer cancel()

	if err := db.WithContext(ctx).Where("player_id = ?", playerID).First(&item).Error; err != nil {
		atomic.AddInt32(&globalDBCounter, 1)
		return nil, err
	}

	atomic.AddInt32(&globalDBCounter, 1)
	return item, nil
}

// 初始化表名到结构体工厂函数的映射（纯接口方式）
func initTableModelFactories() {
	tableModelFactories["players"] = func() DataModel { return &Player{} }
	tableModelFactories["inventory"] = func() DataModel { return &InventoryItem{} }
}

// initDB 初始化全局数据库连接
func initDB() {
	var err error

	// 配置GORM日志级别
	logLevel := logger.Warn
	if isDebugMode() {
		logLevel = logger.Info
	}

	// 初始化数据库连接
	globalDB, err = gorm.Open(sqlite.Open("test.db"), &gorm.Config{
		Logger: logger.Default.LogMode(logLevel),
	})
	if err != nil {
		log.Fatalf("Failed to connect to database: %v", err)
	}

	// 初始化表名到结构体工厂函数的映射
	initTableModelFactories()

	// 配置数据库连接池
	sqlDB, err := globalDB.DB()
	if err != nil {
		log.Fatalf("Failed to get raw DB connection: %v", err)
	}
	sqlDB.SetMaxOpenConns(50)           // 增加最大连接数
	sqlDB.SetMaxIdleConns(20)           // 增加最大空闲连接数
	sqlDB.SetConnMaxLifetime(time.Hour) // 连接最大存活时间
	sqlDB.SetConnMaxIdleTime(30 * time.Minute) // 空闲连接最大存活时间
}

// 检查是否为调试模式
func isDebugMode() bool {
	// 实际应用中可从配置或环境变量获取
	return false
}

// GetTableDataByID 获取指定玩家和表的数据（使用优化后的缓存机制）
func GetTableDataByID(playerID uint, tableName string) (interface{}, error) {
	// 1. 获取或创建玩家缓存
	_, err := cacheManager.getOrCreatePlayerCache(playerID)
	if err != nil {
		return nil, err
	}

	// 2. 获取或创建表缓存
	tableCache := cacheManager.getOrCreateTableCache(playerID, tableName)

	// 3. 获取缓存数据（自动处理过期）
	data, err := cacheManager.getCacheData(tableCache, globalDB, playerID, tableName)
	if err != nil {
		return nil, err
	}

	return data, nil
}

// 记录性能指标
func recordPerformanceMetrics() {
	ticker := time.NewTicker(30 * time.Second)
	go func() {
		for range ticker.C {
			dbCount := atomic.SwapInt32(&globalDBCounter, 0)
			log.Printf("Performance metrics: DB queries in last 30s: %d", dbCount)
		}
	}()
}

// main 函数
func main() {
	// 初始化缓存管理器
	cacheManager = NewCacheManager()

	// 初始化数据库
	initDB()

	log.Println("Database initialized successfully")

	// 启动定时缓存清理
	cacheManager.StartCleaner(CleanupInterval, IdleThreshold)

	// 启动性能指标监控
	recordPerformanceMetrics()

	log.Println("Program started successfully")

	// 保持程序运行（根据实际需求调整）
	select {}
}
